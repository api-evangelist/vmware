          "name": "Vmware Create a New Authentication Session",
          "request": {
            "name": "Vmware Create a New Authentication Session",
            "description": {
              "content": "Creates a new session by authenticating with vCenter Server credentials. Returns a session identifier that must be included in the vmware-api-session-id header for subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "session"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of your vCenter Server instance",
                  "type": "any",
                  "value": "{{vcenter}}",
                  "key": "vcenter"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
