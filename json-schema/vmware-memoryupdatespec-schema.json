{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/MemoryUpdateSpec",
  "title": "MemoryUpdateSpec",
  "type": "object",
  "description": "Specification for memory configuration",
  "properties": {
    "size_MiB": {
      "type": "integer",
      "description": "Memory size in mebibytes",
      "minimum": 4,
      "example": 10
    },
    "hot_add_enabled": {
      "type": "boolean",
      "example": true
    }
  }
}