{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/NetworkSummary",
  "title": "NetworkSummary",
  "type": "object",
  "description": "Summary of a network in the vCenter inventory",
  "required": [
    "network",
    "name"
  ],
  "properties": {
    "network": {
      "type": "string",
      "description": "Unique identifier of the network",
      "example": "example_value"
    },
    "name": {
      "type": "string",
      "description": "Display name of the network",
      "example": "Example Title"
    },
    "type": {
      "type": "string",
      "description": "Type of the network",
      "enum": [
        "STANDARD_PORTGROUP",
        "DISTRIBUTED_PORTGROUP",
        "OPAQUE_NETWORK"
      ],
      "example": "STANDARD_PORTGROUP"
    }
  }
}