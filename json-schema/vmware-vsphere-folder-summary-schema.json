{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FolderSummary",
  "type": "object",
  "description": "Summary of an inventory folder",
  "properties": {
    "folder": {
      "type": "string",
      "description": "Unique identifier of the folder"
    },
    "name": {
      "type": "string",
      "description": "Display name of the folder"
    },
    "type": {
      "type": "string",
      "description": "Type of folder"
    }
  }
}